<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CCAITest</AssemblyName>
  </PropertyGroup>

  <!-- SDK is always the parent directory (integration/ lives inside the SDK repo) -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\CCAI.NET\CCAI.NET.csproj" />
  </ItemGroup>

</Project>
